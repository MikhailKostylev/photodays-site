---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	description: string;
	canonicalPath: string;
	eyebrow?: string;
	heading: string;
	effective?: string;
}

const { title, description, canonicalPath, eyebrow = 'PhotoDays', heading, effective } = Astro.props;
---

<BaseLayout {title} {description} {canonicalPath}>
	<Header />
	<main id="main-content" class="content-main section-shell">
		<article class="content-card">
			<header class="content-heading">
				<div class="eyebrow">{eyebrow}</div>
				<h1>{heading}</h1>
				{effective && <p class="effective-date">{effective}</p>}
			</header>
			<div class="prose">
				<slot />
			</div>
		</article>
	</main>
	<Footer />
</BaseLayout>
