---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	before: ImageMetadata;
	after: ImageMetadata;
	beforeLabel: string;
	afterLabel: string;
	label: string;
}

const { before, after, beforeLabel, afterLabel, label } = Astro.props;
---

<div class="compare-reveal" data-compare-reveal style="--split: 50%">
	<div class="compare-reveal-media" data-compare-surface>
		<Picture
			src={after}
			formats={['avif', 'webp']}
			widths={[480, 720, 960, 1280]}
			sizes="(max-width: 760px) calc(100vw - 40px), 820px"
			alt={`${afterLabel} progress portrait`}
		/>
		<div class="compare-reveal-before" aria-hidden="true">
			<div class="compare-reveal-before-inner">
				<Picture
					src={before}
					formats={['avif', 'webp']}
					widths={[480, 720, 960, 1280]}
					sizes="(max-width: 760px) calc(100vw - 40px), 820px"
					alt=""
				/>
			</div>
		</div>
		<span class="compare-reveal-label compare-reveal-label-before">{beforeLabel}</span>
		<span class="compare-reveal-label compare-reveal-label-after">{afterLabel}</span>
		<div
			class="compare-reveal-separator"
			data-compare-separator
			role="slider"
			tabindex="0"
			aria-label={label}
			aria-valuemin="0"
			aria-valuemax="100"
			aria-valuenow="50"
			aria-valuetext="50% — equal comparison"
		>
			<span class="compare-reveal-handle" aria-hidden="true">
				<svg viewBox="0 0 56 56" width="56" height="56">
					<circle cx="28" cy="28" r="27" />
					<path d="M22 19l-8 9 8 9M34 19l8 9-8 9" />
				</svg>
			</span>
		</div>
	</div>
	<p class="compare-reveal-hint">Drag or tap anywhere on the photo to compare.</p>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-compare-reveal]').forEach((root) => {
		if (root.dataset.initialized === 'true') return;
		root.dataset.initialized = 'true';

		const surface = root.querySelector<HTMLElement>('[data-compare-surface]');
		const separator = root.querySelector<HTMLElement>('[data-compare-separator]');
		if (!surface || !separator) return;

		let value = 50;
		let activePointer: number | null = null;

		const update = (nextValue: number) => {
			value = Math.min(100, Math.max(0, Math.round(nextValue)));
			root.style.setProperty('--split', `${value}%`);
			separator.setAttribute('aria-valuenow', String(value));
			separator.setAttribute('aria-valuetext', `${value}% — Day 1 on the left, Day 365 on the right`);
		};

		const updateFromPointer = (event: PointerEvent) => {
			const bounds = surface.getBoundingClientRect();
			update(((event.clientX - bounds.left) / bounds.width) * 100);
		};

		surface.addEventListener('pointerdown', (event) => {
			if (event.pointerType === 'mouse' && event.button !== 0) return;
			activePointer = event.pointerId;
			surface.setPointerCapture(event.pointerId);
			updateFromPointer(event);
		});

		surface.addEventListener('pointermove', (event) => {
			if (activePointer !== event.pointerId) return;
			updateFromPointer(event);
		});

		const release = (event: PointerEvent) => {
			if (activePointer !== event.pointerId) return;
			if (surface.hasPointerCapture(event.pointerId)) surface.releasePointerCapture(event.pointerId);
			activePointer = null;
		};
		surface.addEventListener('pointerup', release);
		surface.addEventListener('pointercancel', release);

		separator.addEventListener('keydown', (event) => {
			const step = event.shiftKey ? 10 : 2;
			let next = value;
			if (event.key === 'ArrowLeft' || event.key === 'ArrowDown') next -= step;
			else if (event.key === 'ArrowRight' || event.key === 'ArrowUp') next += step;
			else if (event.key === 'Home') next = 0;
			else if (event.key === 'End') next = 100;
			else return;
			event.preventDefault();
			update(next);
		});

		update(value);
	});
</script>
