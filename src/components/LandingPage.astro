---
import { Picture } from 'astro:assets';
import appIcon from '../assets/app-icon.png';
import dayOne from '../assets/demo/day-1.jpg';
import day365 from '../assets/demo/day-365.jpg';
import cameraScreen from '../assets/screens/camera.png';
import compareScreen from '../assets/screens/compare.png';
import homeScreen from '../assets/screens/home.png';
import progressScreen from '../assets/screens/progress.png';
import shareScreen from '../assets/screens/share.png';
import videoScreen from '../assets/screens/video.png';
import { copy } from '../data/site';
import AppStoreCTA from './AppStoreCTA.astro';
import CompareReveal from './CompareReveal.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import PhoneFrame from './PhoneFrame.astro';
import ProductVideo from './ProductVideo.astro';
import ProgressLoop from './ProgressLoop.astro';

const benefitScreens = [compareScreen, homeScreen, progressScreen, shareScreen];
const benefitAlts = [
	'PhotoDays comparison screen showing Day 1 and Day 365',
	'PhotoDays journal home screen with a dedicated album',
	'PhotoDays progress screen with a goal and streak',
	'PhotoDays share sheet after saving a progress film',
];
const flowScreens = [cameraScreen, homeScreen, videoScreen];
const flowAlts = [
	'PhotoDays camera with alignment guidance',
	'PhotoDays visual journal ready for the next entry',
	'PhotoDays progress-film editor',
];
---

<Header home />

<main id="main-content">
	<section class="hero section-shell" aria-labelledby="hero-title">
		<div class="hero-copy">
			<div class="eyebrow">{copy.hero.eyebrow}</div>
			<h1 id="hero-title">{copy.hero.title}</h1>
			<p class="hero-body">{copy.hero.body}</p>
			<div class="hero-actions">
				<AppStoreCTA />
				<a class="secondary-cta" href="#demo">
					<span aria-hidden="true">▶</span>
					{copy.hero.demo}
				</a>
			</div>
			<p class="privacy-note">
				<span aria-hidden="true">⌾</span>
				{copy.hero.note}
			</p>
		</div>

		<div class="hero-proof" aria-label="A real PhotoDays progress sequence and app home screen">
			<div class="hero-proof-glow" aria-hidden="true"></div>
			<figure class="hero-photo hero-photo-before">
				<Picture
					src={dayOne}
					formats={['avif', 'webp']}
					widths={[320, 480, 640]}
					sizes="(max-width: 760px) 42vw, 280px"
					alt="Day 1 portrait in a real PhotoDays progress sequence"
					loading="eager"
				/>
				<figcaption>Day 1</figcaption>
			</figure>
			<figure class="hero-photo hero-photo-after">
				<Picture
					src={day365}
					formats={['avif', 'webp']}
					widths={[400, 640, 800]}
					sizes="(max-width: 760px) 55vw, 360px"
					alt="Day 365 portrait in the same PhotoDays progress sequence"
					loading="eager"
					fetchpriority="high"
				/>
				<figcaption>Day 365</figcaption>
			</figure>
			<PhoneFrame src={homeScreen} alt="PhotoDays home screen" class="hero-app-phone" priority />
			<div class="hero-proof-note">
				<strong>365 days</strong>
				<span>made visible</span>
			</div>
		</div>
	</section>

	<section class="comparison section-shell" id="compare" aria-labelledby="comparison-title">
		<div class="section-heading comparison-heading">
			<div>
				<div class="eyebrow">{copy.compare.eyebrow}</div>
				<h2 id="comparison-title">{copy.compare.title}</h2>
			</div>
			<p>{copy.compare.body}</p>
		</div>
		<CompareReveal
			before={dayOne}
			after={day365}
			beforeLabel={copy.compare.before}
			afterLabel={copy.compare.after}
			label={copy.compare.label}
		/>
	</section>

	<section class="benefits section-shell" id="why" aria-labelledby="benefits-title">
		<header class="benefits-intro">
			<div class="eyebrow">Not more photos. More meaning.</div>
			<h2 id="benefits-title">PhotoDays gives slow progress somewhere to become obvious.</h2>
		</header>
		<div class="benefit-list">
			{copy.benefits.map((benefit, index) => (
				<article class:list={['benefit-chapter', { 'benefit-chapter-reverse': index % 2 === 1 }]}>
					<div class="benefit-copy">
						<span class="chapter-number">{benefit.number}</span>
						<h3>{benefit.title}</h3>
						<p>{benefit.body}</p>
						<span class="benefit-proof"><span aria-hidden="true">↗</span>{benefit.proof}</span>
					</div>
					<div class:list={['benefit-visual', `benefit-visual-${index + 1}`]}>
						<PhoneFrame src={benefitScreens[index]} alt={benefitAlts[index]} class="benefit-phone" />
						{index === 0 && (
							<div class="benefit-photo-pair" aria-hidden="true">
								<Picture src={dayOne} formats={['webp']} widths={[180]} alt="" />
								<Picture src={day365} formats={['webp']} widths={[180]} alt="" />
							</div>
						)}
						{index === 2 && (
							<div class="gentle-rhythm-card" aria-hidden="true">
								<span>YOUR RHYTHM</span>
								<strong>18 day streak</strong>
								<small>One moment at a time</small>
							</div>
						)}
					</div>
				</article>
			))}
		</div>
	</section>

	<section class="film-section" aria-labelledby="film-title">
		<div class="section-shell film-layout">
			<div class="film-copy">
				<div class="eyebrow">{copy.progressFilm.eyebrow}</div>
				<h2 id="film-title">{copy.progressFilm.title}</h2>
				<p>{copy.progressFilm.body}</p>
				<div class="film-days" aria-hidden="true">
					<span>01</span><i></i><span>35</span>
				</div>
			</div>
			<ProgressLoop />
		</div>
	</section>

	<section class="flow section-shell" aria-labelledby="flow-title">
		<div class="section-heading centered">
			<div class="eyebrow">{copy.flow.eyebrow}</div>
			<h2 id="flow-title">{copy.flow.title}</h2>
		</div>
		<ol class="flow-grid">
			{copy.flow.items.map((item, index) => (
				<li class="flow-card">
					<div class="flow-visual">
						<PhoneFrame src={flowScreens[index]} alt={flowAlts[index]} class="flow-phone" />
					</div>
					<div class="flow-copy">
						<span>0{index + 1}</span>
						<h3>{item.title}</h3>
						<p>{item.body}</p>
					</div>
				</li>
			))}
		</ol>
	</section>

	<section class="demo section-shell" id="demo" aria-labelledby="demo-title">
		<div class="demo-card">
			<div class="demo-copy">
				<div class="eyebrow">{copy.demo.eyebrow}</div>
				<h2 id="demo-title">{copy.demo.title}</h2>
				<p>{copy.demo.body}</p>
				<div class="demo-sequence" aria-label="Product demo chapters">
					<span>Capture</span>
					<i aria-hidden="true"></i>
					<span>Compare</span>
					<i aria-hidden="true"></i>
					<span>Create</span>
				</div>
			</div>
			<div class="demo-media">
				<ProductVideo />
			</div>
		</div>
	</section>

	<section class="uses section-shell" aria-labelledby="uses-title">
		<div class="uses-intro">
			<div class="eyebrow">{copy.uses.eyebrow}</div>
			<h2 id="uses-title">{copy.uses.title}</h2>
		</div>
		<ul class="use-list" role="list">
			{copy.uses.items.map((item, index) => (
				<li>
					<span class="use-index">0{index + 1}</span>
					<span>{item}</span>
					<span aria-hidden="true">↗</span>
				</li>
			))}
		</ul>
	</section>

	<section class="privacy-section section-shell" aria-labelledby="privacy-title">
		<div class="privacy-card">
			<div class="privacy-copy">
				<div class="eyebrow">{copy.privacy.eyebrow}</div>
				<h2 id="privacy-title">{copy.privacy.title}</h2>
				<p>{copy.privacy.body}</p>
				<ul class="privacy-points" role="list">
					{copy.privacy.points.map((point, index) => (
						<li><span aria-hidden="true">{['⌂', '☁', '◉'][index]}</span>{point}</li>
					))}
				</ul>
				<a class="text-link" href="/privacy/">{copy.privacy.link}<span aria-hidden="true">→</span></a>
			</div>
			<div class="privacy-visual" aria-hidden="true">
				<div class="privacy-orbit privacy-orbit-one"></div>
				<div class="privacy-orbit privacy-orbit-two"></div>
				<div class="privacy-lock">
					<Picture src={appIcon} formats={['avif', 'webp']} widths={[144, 288]} alt="" />
					<span>Private by design</span>
				</div>
			</div>
		</div>
	</section>

	<section class="final-cta section-shell" aria-labelledby="final-title">
		<div class="final-card">
			<div class="final-icon">
				<Picture src={appIcon} formats={['avif', 'webp']} widths={[112, 224]} alt="PhotoDays app icon" />
			</div>
			<div class="eyebrow">{copy.final.eyebrow}</div>
			<h2 id="final-title">{copy.final.title}</h2>
			<p>{copy.final.body}</p>
			<AppStoreCTA />
		</div>
	</section>
</main>

<Footer />
