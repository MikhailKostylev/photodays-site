---
import { Picture } from 'astro:assets';
import { siteConfig } from '../config';
import Header from './Header.astro';
import Footer from './Footer.astro';
import AppStoreCTA from './AppStoreCTA.astro';
import CompareReveal from './CompareReveal.astro';
import PhoneFrame from './PhoneFrame.astro';
import ProductVideo from './ProductVideo.astro';
import ProgressLoop from './ProgressLoop.astro';
import FAQ from './FAQ.astro';
import TopicLinks from './TopicLinks.astro';
import day1 from '../assets/demo/day-1.jpg';
import day365 from '../assets/demo/day-365.jpg';
import home from '../assets/screens/home.png';
import gallery from '../assets/screens/gallery.png';
import progress from '../assets/screens/progress.png';
import chart from '../assets/screens/chart-year-activity.png';
import achievements from '../assets/screens/achievements-profile.png';
const questions = [
 { question: 'What is PhotoDays?', answer: 'PhotoDays is a photo diary app for iPhone and iPad. Keep photos and Live Photos in albums, add notes, compare dates and make a video from the moments you collect.' },
 { question: 'Do I need to take one photo every day?', answer: 'No. A daily photo can be a lovely habit, but your diary can be weekly or occasional too. Choose reminders that fit what you are recording.' },
 { question: 'Can I use photos I already have?', answer: 'Yes. You can capture a new photo or import photos and Live Photos from your library, then organize them into the album they belong to.' },
 { question: 'Are my photos public?', answer: 'No. PhotoDays has no public feed. Your albums are stored on your device, and you choose what to export or share. Face ID or Touch ID can protect access to the app or individual albums.' },
 { question: 'Is PhotoDays available to download?', answer: siteConfig.appStoreUrl ? 'Yes. PhotoDays is available on the App Store for iPhone and iPad. Use the download link on this page to see the current listing.' : 'PhotoDays is currently in testing. It is coming soon to the App Store for iPhone and iPad. The download link will appear here when it is available.' },
];
---
<Header home />
<main id="main-content">
 <section class="hero section-shell" aria-labelledby="hero-title">
  <div class="hero-copy">
   <p class="eyebrow">Photo diary for iPhone & iPad</p>
   <h1 id="hero-title">Life changes.<br />Keep <em>the pictures.</em></h1>
   <p class="hero-description">A photo diary app for the moments you want to remember—and the progress you want to see. One album, one photo, one day at a time.</p>
   <div class="hero-actions"><a class="button-link" href="#demo">Watch PhotoDays <span aria-hidden="true">↗</span></a><AppStoreCTA /></div>
   <p class="hero-note">Your photos. Your pace. No public feed.</p>
  </div>
  <div class="hero-art" aria-label="A year of photos, organized in PhotoDays">
   <figure class="photo-print print-first"><Picture src={day1} width={480} formats={['avif','webp']} widths={[240,480]} sizes="(max-width: 700px) 32vw, 200px" alt="First portrait in a PhotoDays photo sequence" loading="eager" /><figcaption><span>First photo</span><span>Day 1</span></figcaption></figure>
   <figure class="photo-print print-last"><Picture src={day365} width={640} formats={['avif','webp']} widths={[320,640]} sizes="(max-width: 700px) 38vw, 260px" alt="Portrait from the same photo sequence on Day 365" loading="eager" fetchpriority="high" /><figcaption><span>A year later</span><span>Day 365</span></figcaption></figure>
   <PhoneFrame src={home} alt="PhotoDays home screen with a photo calendar and a personal album" class="hero-phone" priority />
   <p class="art-caption">Small moments. A longer story.</p>
  </div>
 </section>
 <div class="intro-strip section-shell"><span>A place for your everyday</span><span>Photos & Live Photos</span><span>Made for iPhone & iPad</span></div>
 <section class="section-shell section-block compare-section" id="compare" aria-labelledby="compare-title">
  <div class="section-intro"><p class="eyebrow">01 / Notice the difference</p><h2 id="compare-title">Some changes<br />take a second look.</h2><p>Put the first photo beside the latest. The same face, project or little corner of your world—seen across time.</p><a class="text-link" href="/progress-photos/">Explore progress photo tracking <span aria-hidden="true">↗</span></a></div>
  <div class="comparison-stage"><CompareReveal before={day1} after={day365} beforeLabel="Day 1" afterLabel="Day 365" label="Compare Day 1 and Day 365" /><p class="caption">One photo sequence. Two moments, a year apart.</p></div>
 </section>
 <section class="demo-section" id="demo" aria-labelledby="demo-title"><div class="section-shell demo-grid">
  <div class="section-intro"><p class="eyebrow">02 / A look inside</p><h2 id="demo-title">From a single photo<br />to a story in motion.</h2><p>See how PhotoDays brings capture, comparison and a progress video together in this 25-second walkthrough.</p><ol class="demo-steps"><li><span>01</span>Keep a moment</li><li><span>02</span>See what changed</li><li><span>03</span>Make a film</li></ol><a class="text-link" href="/photo-progress-video/">Make a video from your photos <span aria-hidden="true">↗</span></a></div>
  <div class="demo-device"><ProductVideo /></div>
 </div></section>
 <section class="section-shell section-block" id="why" aria-labelledby="features-title">
  <div class="section-heading"><p class="eyebrow">03 / Make room for the everyday</p><h2 id="features-title">A little more intention.<br />A lot less camera-roll scrolling.</h2></div>
  <div class="feature-pair">
   <article class="feature"><div class="feature-image"><PhoneFrame src={gallery} alt="A PhotoDays album with photos organized by date" /></div><p class="eyebrow">A place for each story</p><h3>Keep the photos that belong together.</h3><p>Create an album for everyday memories or a longer project. Browse your photo journal by date, revisit the calendar and add notes for the details a picture cannot tell.</p></article>
   <article class="feature"><div class="feature-image"><PhoneFrame src={progress} alt="PhotoDays progress view with a streak and recorded milestones" /></div><p class="eyebrow">A rhythm that fits</p><h3>Come back when it matters.</h3><p>Set a reminder, build a photo habit and see your streak grow. Your photo tracker works with a daily, weekly or occasional routine.</p></article>
  </div>
  <div class="insights-row"><div><p class="eyebrow">See the bigger picture</p><h3>The record goes beyond the photos.</h3><p>Album charts bring your recorded activity into view. Streaks and achievements recognize the moments you keep returning to.</p></div><div class="insights-screens"><PhoneFrame src={chart} alt="PhotoDays chart showing recorded activity throughout the year" /><PhoneFrame src={achievements} alt="PhotoDays profile with a streak and earned achievements" /></div></div>
 </section>
 <section class="section-shell section-block topics-section" aria-labelledby="topics-title"><div class="section-heading"><p class="eyebrow">04 / Find your reason</p><h2 id="topics-title">What will you keep?</h2><p>A daily selfie. A plant putting out new leaves. A project slowly taking shape. Start with whatever you want to see again.</p></div><TopicLinks /></section>
 <section class="film-note section-shell"><div class="film-mini"><ProgressLoop /></div><div><p class="eyebrow">35 photos / 365 days</p><h2>A year, worth<br />looking back on.</h2><p>Turn the photos you collect into a progress film. Keep it for yourself, or export a video or GIF to share.</p><a class="text-link" href="/photo-progress-video/">See how photo videos work <span aria-hidden="true">↗</span></a></div></section>
 <section class="privacy-section section-shell" aria-labelledby="privacy-title"><p class="eyebrow">Personal, by design</p><h2 id="privacy-title">An album for you.<br />Not an audience.</h2><p>Keep photos and notes on your device. Protect the app or individual albums with Face ID or Touch ID. Choose what you share.</p><a class="text-link" href="/privacy/">Read the privacy policy <span aria-hidden="true">↗</span></a></section>
 <section class="section-shell faq-section"><div><p class="eyebrow">A few things to know</p><h2>Before your<br />first photo.</h2></div><FAQ items={questions} /></section>
 <section class="final-cta section-shell"><p class="eyebrow">PhotoDays for iPhone & iPad</p><h2>Start with a photo.<br /><em>See where it takes you.</em></h2><div class="hero-actions"><a class="button-link" href="#demo">Watch the demo <span aria-hidden="true">↗</span></a><AppStoreCTA /></div></section>
</main>
<Footer />
