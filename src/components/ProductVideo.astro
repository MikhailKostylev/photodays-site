---
import poster from '../assets/video/product-demo-poster.webp';
---

<div class="product-video" data-product-video>
	<video
		data-product-video-element
		preload="none"
		muted
		playsinline
		loop
		poster={poster.src}
		aria-describedby="product-video-description"
	>
		<source data-src="/media/photodays-product-demo.mp4" type="video/mp4" />
	</video>
	<button
		class="media-toggle product-video-toggle"
		type="button"
		data-product-video-toggle
		data-play-label="Play demo"
		data-pause-label="Pause demo"
		aria-label="Play demo"
		aria-pressed="false"
	>
		<span data-product-video-icon aria-hidden="true">▶</span>
		<span data-product-video-label>Play demo</span>
	</button>
</div>
<p class="video-description" id="product-video-description">
	Silent video: PhotoDays opens a visual journal, shows progress and a goal, guides the next photo, compares Day 1 with Day 365, then creates and shares a progress film.
</p>

<script>
	document.querySelectorAll<HTMLElement>('[data-product-video]').forEach((root) => {
		if (root.dataset.initialized === 'true') return;
		root.dataset.initialized = 'true';

		const video = root.querySelector<HTMLVideoElement>('[data-product-video-element]');
		const source = video?.querySelector<HTMLSourceElement>('source[data-src]');
		const toggle = root.querySelector<HTMLButtonElement>('[data-product-video-toggle]');
		const icon = root.querySelector<HTMLElement>('[data-product-video-icon]');
		const text = root.querySelector<HTMLElement>('[data-product-video-label]');
		if (!video || !source || !toggle || !icon || !text) return;

		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let loaded = false;
		let visible = false;
		let explicitlyPaused = false;
		const load = () => {
			if (loaded || !source.dataset.src) return;
			source.src = source.dataset.src;
			video.load();
			loaded = true;
		};
		const updateControl = () => {
			const playing = !video.paused && !video.ended;
			const label = playing ? toggle.dataset.pauseLabel : toggle.dataset.playLabel;
			toggle.setAttribute('aria-pressed', String(playing));
			toggle.setAttribute('aria-label', label ?? '');
			text.textContent = label ?? '';
			icon.textContent = playing ? 'Ⅱ' : '▶';
		};
		const play = async () => {
			load();
			try { await video.play(); } catch { updateControl(); }
		};

		toggle.addEventListener('click', () => {
			if (video.paused) {
				explicitlyPaused = false;
				play();
			} else {
				explicitlyPaused = true;
				video.pause();
			}
		});
		video.addEventListener('play', updateControl);
		video.addEventListener('pause', updateControl);

		const preloadObserver = new IntersectionObserver(([entry]) => {
			if (!entry.isIntersecting) return;
			load();
			preloadObserver.disconnect();
		}, { rootMargin: '360px 0px', threshold: 0 });
		preloadObserver.observe(root);

		const playbackObserver = new IntersectionObserver(([entry]) => {
			visible = entry.isIntersecting && entry.intersectionRatio >= 0.35;
			if (visible && !reducedMotion.matches && !explicitlyPaused) play();
			if (!visible && !video.paused) video.pause();
		}, { threshold: [0, 0.35, 0.7] });
		playbackObserver.observe(root);

		document.addEventListener('visibilitychange', () => {
			if (document.hidden && !video.paused) video.pause();
			else if (!document.hidden && visible && !reducedMotion.matches && !explicitlyPaused) play();
		});
		reducedMotion.addEventListener('change', (event) => {
			if (event.matches) video.pause();
			else if (visible && !explicitlyPaused) play();
		});
		updateControl();
	});
</script>
