---
import { Picture } from 'astro:assets';
import appIcon from '../assets/app-icon.png';
interface Props { home?: boolean }
const { home = false } = Astro.props;
---
<header class="site-header"><div class="header-inner"><a class="brand" href="/" aria-label="PhotoDays home"><Picture src={appIcon} width={80} formats={['avif','webp']} widths={[40,80]} sizes="36px" alt="" class="brand-icon" /><span>PhotoDays</span></a><nav class="desktop-nav" aria-label="Main navigation"><a href="/photo-diary/">Photo diary</a><a href="/progress-photos/">Progress photos</a><a href="/photo-progress-video/">Photo videos</a><a href="/support/">Support</a></nav><a class="header-demo" href={home ? '#demo' : '/#demo'}>See it in action <span aria-hidden="true">↗</span></a><details class="mobile-nav"><summary>Menu</summary><nav aria-label="Mobile navigation"><a href="/photo-diary/">Photo diary</a><a href="/progress-photos/">Progress photos</a><a href="/photo-progress-video/">Photo videos</a><a href="/support/">Support</a><a href="/privacy/">Privacy</a></nav></details></div></header>
